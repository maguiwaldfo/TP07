@using TP07.Models
@model List<Publicacion>

@{
    ViewData["Title"] = "Inicio";
}

<h1>Publicaciones</h1>

<a class="btn-crear" href='@Url.Action("Crear", "Publicacion")'>Crear publicación</a>

@if (Model.Count == 0)
{
    <p>No hay publicaciones.</p>
}
else
{
    @foreach (Publicacion publicacion in Model)
    {
        <article class="publicacion">
            <div class="publicacion-header">
                <div class="publicacion-user">
                    <div class="avatar">@publicacion.NombreUsuario.Substring(0, 1).ToUpper()</div>
                    <div>
                        <h2>@publicacion.NombreUsuario</h2>
                        <small>@publicacion.FechaPublicacion.ToString("dd MMM yyyy")</small>
                    </div>
                </div>
                <span class="text-muted">@publicacion.Titulo</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(publicacion.Imagen))
            {
                <img class="post-image" src="@Url.Content("~/imagenes/" + publicacion.Imagen)" alt="Imagen de la publicación" />
            }

            <div class="publicacion-body">
                <div class="post-actions">
                    <button type="button" onclick="MeGusta(@publicacion.Id)">♡ Me gusta</button>
                </div>

                <span class="like-count">
                    <span id="cantidad-@publicacion.Id">@publicacion.CantidadMeGusta</span> me gusta
                </span>

                <p><strong>@publicacion.NombreUsuario</strong> <span class="descripcion">@publicacion.Descripcion</span></p>
            </div>

            <div class="comentarios">
                <h3>Comentarios</h3>

                @if (publicacion.Comentarios != null)
                {
                    @foreach (Comentario comentario in publicacion.Comentarios)
                    {
                        <div class="comentario">
                            <strong>@comentario.NombreUsuario:</strong>
                            @comentario.Texto
                        </div>
                    }
                }
            </div>

            <div class="comentario-box">
                <input type="text" id="texto-@publicacion.Id" placeholder="Agrega un comentario...">
                <button type="button" onclick="Comentar(@publicacion.Id)">Publicar</button>
            </div>
        </article>
    }
}

<script src="~/js/publicaciones.js"></script>