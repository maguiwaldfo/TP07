@using TP07.Models
@model List<Publicacion>

@{
    ViewData["Title"] = "Inicio";
}

<h1>Publicaciones</h1>

<a href='@Url.Action("Crear", "Publicacion")'>Crear publicación</a>

@if (Model.Count == 0)
{
    <p>No hay publicaciones.</p>
}
else
{
    @foreach (Publicacion publicacion in Model)
    {
        <div class="publicacion">

            <h2>@publicacion.Titulo</h2>

            @if (publicacion.Imagen != null && publicacion.Imagen != "")
            {
                <img src="@publicacion.Imagen" alt="Imagen de la publicación">
            }

            <p>@publicacion.Descripcion</p>

            <p>Publicado por: @publicacion.NombreUsuario</p>

            <p>Fecha: @publicacion.FechaPublicacion</p>

            <p>
                Me gusta: @publicacion.CantidadMeGusta
            </p>

            <button>Me gusta</button>

        </div>
    }
<script src="~/js/publicaciones.js"></script>
}