@using TP07.Models
@model Publicacion

@{
    ViewData["Title"] = "Crear publicación";
}

<div class="crear-publicacion-wrap">
    <div class="crear-publicacion-card">
        <h1>Crear publicación</h1>

        <form class="crear-form" action='@Url.Action("Crear", "Publicacion")' method="post">

            <div class="campo-form">
                <label for="Titulo">Título</label>
                <input id="Titulo" type="text" name="Titulo" placeholder="Ej: Mi viaje a Bariloche" required>
            </div>

            <div class="campo-form">
                <label for="Descripcion">Descripción</label>
                <textarea id="Descripcion" name="Descripcion" rows="5" placeholder="Contale a tu comunidad qué estás compartiendo..." required></textarea>
            </div>

            <div class="campo-form">
                <label for="Imagen">Nombre de la imagen</label>
                <input id="Imagen" type="text" name="Imagen" placeholder="Ej: recital.jpg">
            </div>

            <div class="acciones-form">
                <button type="submit" class="btn-publicar">Publicar</button>
                <a class="btn-volver" href='@Url.Action("Index", "Home")'>Volver al inicio</a>
            </div>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alerta-error">@ViewBag.Error</div>
        }
    </div>
</div>